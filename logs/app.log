from typing import Any, Dict

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QPushButton,
    QVBoxLayout,
    QWidget,
)


class Plugin:
    """输入 + 按钮 + 输出结果的工具类插件示例。"""

    name = "文本处理工具"
    description = "输入文本，点击按钮后在下方显示处理结果。"
    version = "1.0.0"
    author = "Toolbox Framework"
    category = "示例 / 文本"
    icon = ""  # 可替换为实际图标路径

    def __init__(self, event_bus, config_manager, logger, plugin_id: str, plugin_dir) -> None:
        self._event_bus = event_bus
        self._config_manager = config_manager
        self._logger = logger
        self._plugin_id = plugin_id
        self._plugin_dir = plugin_dir

        self._config = self._config_manager.load(self._plugin_id)

    def on_load(self) -> None:
        self._logger.info("TextTool Plugin loaded")

    def on_unload(self) -> None:
        self._logger.info("TextTool Plugin unloaded")

    def get_widget(self, parent: QWidget) -> QWidget:
        widget = QWidget(parent)

        root_layout = QVBoxLayout()
        root_layout.setContentsMargins(24, 24, 24, 24)
        root_layout.setSpacing(16)

        input_row = QHBoxLayout()
        input_label = QLabel("输入文本：")
        input_edit = QLineEdit()
        input_edit.setPlaceholderText("在这里输入内容...")

        # 从配置恢复上次输入（示例）
        last_text = self._config.get("last_text", "")
        input_edit.setText(last_text)

        input_row.addWidget(input_label)
        input_row.addWidget(input_edit)

        button = QPushButton("处理为大写并输出")
        result_label = QLabel("结果：")

        def on_process() -> None:
            text = input_edit.text()
            upper = text.upper()
            result_label.setText(f"结果：{upper}")

            # 保存配置
            self._config["last_text"] = text
            self._config_manager.save(self._plugin_id, self._config)

            self._logger.info("Processed text '%s' -> '%s'", text, upper)

            # 发布事件
            self._event_bus.publish(
                "text_tool.processed",
                {"original": text, "result": upper},
                "text_tool",
            )

        button.clicked.connect(on_process)

        root_layout.addLayout(input_row)
        root_layout.addWidget(button)
        root_layout.addWidget(result_label)
        root_layout.addStretch()

        widget.setLayout(root_layout)
        return widget


